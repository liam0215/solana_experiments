# Optional: copy this file to workspace.env and edit for your host.
# For build and init-ledger, no environment file is needed.
# Junction and Caladan must be installed and configured separately.
JUNCTION_RUN=/absolute/path/to/junction_run

# The launcher defaults to configs/validator.config and configs/bench.config.
# To leave those tracked examples unchanged, copy them into configs/local/
# and set the paths below. This directory is ignored by Git.
# JUNCTION_VALIDATOR_CONFIG=/absolute/path/to/configs/local/validator.config
# JUNCTION_BENCH_CONFIG=/absolute/path/to/configs/local/bench.config

# QATLIB_SRC defaults to the sibling qat_driver submodule and QATLIB_BUILD
# defaults to its build/ directory. Override BUILD only for a custom output.
# QATLIB_BUILD=/absolute/path/to/qat_driver/build

# MASTER_HOST is read from the validator config's host_addr by default.
# BENCH_DURATION=50
# BENCH_TX_COUNT=50000
